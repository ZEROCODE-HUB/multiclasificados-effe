# Copia este archivo como `.env` y completa los valores.
# Los encuentras en Supabase → Settings → API
VITE_SUPABASE_URL=https://prhbgniwymaaevnisyov.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Dominio público de la app. Se usa como base de los enlaces del correo de
# restablecimiento de contraseña, para que apunten a producción aunque el reset
# se dispare desde localhost. Si se deja vacío, se usa window.location.origin.
# También es la base de la página de pago (/pay) que abre el APK.
VITE_PUBLIC_SITE_URL=https://multiclasificados-effe.vercel.app

# ─── Pasarela de pagos Izipay/Lyra (micuentaweb.pe) ───────────────────────────
# Estas dos son PÚBLICAS (van en el bundle). Las llaves SECRETAS (Shop ID,
# password, HMAC) NO van aquí: se cargan como secrets de Supabase Edge Functions
# (ver supabase/functions/create-payment/DEPLOY.md y payment-webhook/DEPLOY.md).
# La clave pública se obtiene en el Back Office → Configuración › Tienda › Claves
# de API REST (formato "ShopID:testpublickey_..." en TEST, "...:publickey_..." en prod).
VITE_IZIPAY_PUBLIC_KEY=
VITE_IZIPAY_STATIC_ENDPOINT=https://static.micuentaweb.pe

# ─── Mapas y direcciones ──────────────────────────────────────────────────────
# Llave de Google Maps. Se usa para BUSCAR DIRECCIONES al publicar un aviso
# ("Av. Larco 1234" → punto en el mapa) mediante la GEOCODING API. Sin ella se
# cae a Nominatim (OpenStreetMap): gratis, pero con mala cobertura de calles en
# Perú y un límite de una consulta por segundo.
#
# Geocoding y no Places, comprobado contra la API real: Geocoding responde con
# cabeceras CORS (el navegador la deja llamar), Places legacy no las manda, y
# Places (New) hay que habilitarla aparte. Geocoding es además la más barata.
#
# ⚠️ Esta llave viaja dentro del código que descarga el navegador: es pública por
# naturaleza. Restríngela en la consola de Google a la Geocoding API y, en web, a
# tu dominio. Si hace falta esconderla del todo, hay que llamarla desde una Edge
# Function en vez de desde el navegador.
VITE_GOOGLE_MAPS_API_KEY=

# De dónde salen las imágenes del mapa. Si se deja vacío se usan los servidores
# comunitarios de OpenStreetMap, cuya política de uso NO permite alimentar una
# app distribuida: funcionan con poco tráfico, pero pueden bloquear el dominio
# sin avisar y dejar los tres mapas en gris. Para producción, poner un proveedor
# (Mapbox, MapTiler…) con el formato {z}/{x}/{y}:
#   VITE_MAP_TILES_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/{z}/{x}/{y}?access_token=TU_TOKEN
#   VITE_MAP_TILES_ATTRIBUTION=&copy; Mapbox &copy; OpenStreetMap
VITE_MAP_TILES_URL=
VITE_MAP_TILES_ATTRIBUTION=
