<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link de regreso del OAuth (Google/Facebook): com.effe.multiclasificados://... -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.effe.multiclasificados" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Ubicación: la usa el botón "Ver los más cercanos" del buscador, que llama a
      `navigator.geolocation` desde el WebView (SearchPage.tsx). No hay plugin de
      geolocalización: es la API del navegador.

      Sin estas dos líneas la función NO funciona en el APK, y falla de la peor
      manera posible: en silencio. Capacitor pide los permisos en tiempo de
      ejecución (BridgeWebChromeClient.onGeolocationPermissionsShowPrompt), y
      Android DENIEGA de inmediato —sin enseñar diálogo— cualquier permiso que no
      esté declarado aquí. El usuario pulsa, espera, y le sale "no se pudo
      obtener tu ubicación" sin que nadie le haya preguntado nada.

      Comprobado sobre el AAB del 26-ago-2026 descargado de Actions: llevaba
      POST_NOTIFICATIONS (lo aporta Firebase al fusionar manifests) pero ningún
      permiso de ubicación.

      Van las dos porque Capacitor las pide juntas. Basta con que el usuario
      conceda la aproximada: el buscador pide `enableHighAccuracy: false` y solo
      ordena por cercanía — el filtro sigue siendo el departamento.

      ⚠️ Al publicar en Play hay que declararlo en el formulario de Seguridad de
      los datos. Es ubicación en primer plano, así que no requiere el permiso
      especial de segundo plano ni justificación en vídeo.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
